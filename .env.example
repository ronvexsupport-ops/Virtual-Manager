# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Firebase Client Configuration
# (These are public web client credentials, safe for frontend use)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="your-custom-database-id-or-leave-blank-for-default"

# Server-Side Google Apps Script Email Delivery Configuration
# Web App URL deployed via script.google.com
APPS_SCRIPT_WEB_APP_URL="https://script.google.com/macros/s/AKfycbyb21whHMPfSC7buce1xVsw82j7zGlZ-OE-hB3khD3l3HJg12o-Upayh2LQU0dspyWtlA/exec"
APPS_SCRIPT_SHARED_SECRET="vm_otp_secret_7f8a9b2c3d4e5f"

# Cryptographic Salt & Server Secret for OTP Hashing
OTP_SECRET="virtual-manager-secure-otp-secret-key-2026"

# Firebase Admin SDK Service Account Key (Optional for local Node server, automatic in Firebase Cloud Functions)
# Download from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Paste as single-line JSON string: {"type":"service_account","project_id":"...","private_key":"..."}
FIREBASE_SERVICE_ACCOUNT_KEY=""
