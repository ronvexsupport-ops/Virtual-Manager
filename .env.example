# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Production / Vercel Deployments
# (These are public web client credentials, safe for frontend use)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="your-custom-database-id-or-leave-blank-for-default"

# Server-Side OTP & Email Delivery Service Configuration (Never expose to frontend)
# Use Gmail SMTP / Google Workspace App Password or custom SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="\"Virtual Manager\" <your-email@gmail.com>"

# Secret for signing OTP verification tokens
OTP_SECRET="your-long-random-server-secret-key"
